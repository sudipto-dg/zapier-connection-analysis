# Google Sheets target spreadsheet ID (from the sheet URL)
GOOGLE_SHEET_ID=

# Path to service account JSON key file (relative to repo root or absolute)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=credentials/google-service-account.json

# Optional: override worksheet tab name (default: derived from selectedApi, e.g. mysql_connection_usage_history)
# GOOGLE_SHEET_WORKSHEET=mysql_connection_usage_history

# Optional: IANA timezone for snapshot_date (default: Asia/Kolkata)
# SNAPSHOT_TIMEZONE=Asia/Kolkata

# Optional: parallel zap.searchZaps requests per connection (default: 5)
# ZAPIER_SEARCH_CONCURRENCY=5
